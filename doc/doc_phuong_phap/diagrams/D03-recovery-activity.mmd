%% D03 — RECOVERY activity / loop flowchart
%% Spec refs: 07-recovery-loop, 05-capital-dca, 03-h1-signal, ERRATA (ALL-LLM)
%% Loop until TotalLot == 0 -> FLAT

flowchart TD
  Start([Enter_cycle_RECOVERY_C3_wake_or_H1_closed]) --> FreezeCheck{"SYSTEM_FREEZE_active?"}
  FreezeCheck -->|Yes| FreezeWait[FREEZE_hold_positions_alert_Boss]
  FreezeCheck -->|No| Kill{"Manual_KillSwitch_Boss?"}
  Kill -->|"KillFlatten"| FlatKill["CLOSE_ALL -> FLAT"]
  Kill -->|"Pause"| WaitKill[WAIT_no_new_orders]
  Kill -->|No| Refresh["Engine_computes_Snapshot\nTotalLot_BasketDir_AdverseRef_BasketProfit\nspacing_met_flag_StrengthScore"]

  Refresh --> Zero1{"TotalLot_eq_0?"}
  Zero1 -->|Yes| ExitFlat1["Transition_FLAT\nAlert_EXIT_RECOVERY\nreset_Ladder_Cooldown"]
  Zero1 -->|No| MemPack["Fetch_MemoryPack"]

  MemPack --> AgentEval["Agent_A_proposes_action\nAgent_B_independent_ballot"]

  AgentEval --> Consensus{"A_plus_B_Consensus?"}
  Consensus -->|No_or_VETO| WaitNoCons[WAIT_DEFER_schedule_wake]

  Consensus -->|Yes_APPROVE| HV{"HardValidator_PASS?\nno_opposite_dir_spacing_ok_NormalizeLot"}
  HV -->|No| AlertHV[Alert_rails_block_WAIT]

  HV -->|Yes| ActType{"Consensus_Action_Type"}

  ActType -->|"RECOVERY_DCA"| EnqDca["A_enqueue_RECOVERY_DCA_PENDING\nExecutor_OrderSend_same_BasketDir\nLot_eq_L0_plus_k_x_0.05\nLadderStep_plus_1"]
  EnqDca --> AfterOps

  ActType -->|"CLOSE_ALL_winners"| EnqClose["A_enqueue_CLOSE_ALL_PENDING\nExecutor_closes_all_positions"]
  EnqClose --> AfterOps

  ActType -->|"PAYOFF_REDUCE"| EnqPay["A_enqueue_PAYOFF_REDUCE_PENDING\nExecutor_opens_Payoff_15_to_30pct\nExecutor_closes_or_partials_smallest_loser"]
  EnqPay --> AfterOps

  ActType -->|"WAIT"| WaitNone[WAIT_agents_decided_to_wait]

  WaitNoCons --> EndStay
  AlertHV --> EndStay
  WaitNone --> EndStay
  WaitKill --> EndStay
  FreezeWait --> EndStay

  AfterOps["Refresh_TotalLot_after_ops"] --> Zero2{"TotalLot_eq_0?"}
  Zero2 -->|Yes| ExitFlat2["Transition_FLAT\nAlert_EXIT_RECOVERY"]
  Zero2 -->|No| EndStay["Remain_RECOVERY\nDO_NOT_downgrade_to_NORMAL\neven_if_TotalLot_lt_R_TH_0.3"]

  ExitFlat1 --> End([End_RECOVERY_cycle])
  ExitFlat2 --> End
  FlatKill --> End
  EndStay --> End

  EndStay --> Constraints["Constraints_locked\nall_actions_via_AB_consensus\nno_opposite_direction_open\nno_NORMAL_BasketTP_rule\nno_max_drawdown_auto_stop\nloop_until_flat_or_kill"]
  Constraints --> End
