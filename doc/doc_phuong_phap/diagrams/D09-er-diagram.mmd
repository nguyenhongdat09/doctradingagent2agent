%% D09-er-diagram.mmd
%% ER Diagram: 14 bảng cơ sở dữ liệu SQLite dca_<symbol>.db (v2.3)
%% = 10 vận hành + MarketSnapshots + 3 bảng v2.x (macro_cycles, micro_cycles, contingency_plans)
erDiagram
    MarketOrderInfo {
        INTEGER id PK
        TEXT symbol
        TEXT instance_id
        TEXT plan_id UK
        TEXT action_type
        TEXT direction
        REAL lot
        REAL target_lot
        REAL price_ref
        REAL tp_pips
        REAL sl
        TEXT reason
        TEXT ballot
        TEXT session_mode
        TEXT status
        TIMESTAMP created_at
        TIMESTAMP processed_at
        TEXT error
    }

    MarketOrderInfoArchive {
        INTEGER id PK
        TEXT symbol
        TEXT instance_id
        TEXT plan_id
        TEXT action_type
        TEXT direction
        REAL lot
        REAL executed_price
        REAL executed_lot
        INTEGER ticket
        TEXT fill_status
        TEXT fill_error
        TIMESTAMP archived_at
    }

    PairState {
        TEXT symbol PK
        TEXT state
        TEXT context
        TEXT prev_context
        TEXT basket_dir
        REAL total_lot
        INTEGER ladder_step
        REAL adverse_ref
        TEXT last_processed_bar_id
        TEXT cooldown_until_bar
        TIMESTAMP updated_at
    }

    AuditLog {
        INTEGER id PK
        TIMESTAMP ts
        TEXT symbol
        TEXT event_type
        TEXT plan_id
        TEXT ballot_id
        INTEGER hard_pass
        TEXT decision
        TEXT reason
        TEXT outcome
        TEXT extra
    }

    Plans {
        TEXT plan_id PK
        TEXT symbol
        TEXT action
        TEXT direction
        REAL lot
        TEXT context
        TEXT signal
        TEXT rule_refs
        TEXT thesis
        TEXT risks
        TEXT invalidation
        TEXT status
        TIMESTAMP created_at
    }

    Ballots {
        TEXT ballot_id PK
        TEXT plan_id FK
        INTEGER round
        TEXT decision
        TEXT thesis
        TEXT counter_evidence
        TEXT agree_points
        TEXT dissent_points
        TEXT requested_changes
        REAL similarity_score
        TIMESTAMP created_at
    }

    Sessions {
        TEXT session_id PK
        TEXT symbol
        TEXT trigger_type
        TEXT status
        TIMESTAMP started_at
        TIMESTAMP ended_at
    }

    Messages {
        INTEGER msg_id PK
        TEXT session_id FK
        TEXT sender
        TEXT role
        TEXT content
        TIMESTAMP created_at
    }

    LLMRuns {
        TEXT run_id PK
        TEXT caller
        TEXT model
        TEXT provider
        INTEGER tokens_in
        INTEGER tokens_out
        REAL cost_usd
        INTEGER latency_ms
        TEXT purpose
        TIMESTAMP created_at
    }

    EscalationTickets {
        TEXT ticket_id PK
        TEXT symbol
        TEXT snapshot_id FK
        TEXT category
        TEXT question
        TEXT status
        TEXT boss_reply
        TIMESTAMP created_at
        TIMESTAMP resolved_at
    }

    MarketSnapshots {
        TEXT snapshot_id PK
        TEXT symbol
        TEXT bar_id
        TEXT payload
        TIMESTAMP created_at
    }

    %% ===== v2.x: Unified Contingency Plan lifecycle =====
    macro_cycles {
        TEXT macro_cycle_id PK
        TEXT symbol
        TEXT status
        TIMESTAMP opened_at
        TIMESTAMP closed_at
    }

    micro_cycles {
        TEXT micro_cycle_id PK
        TEXT macro_cycle_id FK
        TEXT bar_id
        TEXT wake_type
        TEXT trigger_event_id
        TIMESTAMP started_at
    }

    contingency_plans {
        TEXT plan_id PK
        TEXT macro_cycle_id FK
        TEXT micro_cycle_id FK
        TEXT symbol
        TEXT plan_state
        TEXT plan_status
        INTEGER is_active
        TEXT scenarios
        TEXT summary_text
        TEXT prune_hint
        TIMESTAMP expires_at
        TIMESTAMP created_at
    }

    Plans ||--o{ Ballots : "được thẩm định bởi"
    Sessions ||--o{ Messages : "chứa các"
    Plans ||--o| MarketOrderInfo : "sinh ra lệnh"
    Plans ||--o{ AuditLog : "ghi nhận trong"
    macro_cycles ||--o{ micro_cycles : "gồm các"
    macro_cycles ||--o{ contingency_plans : "kẹp các plan chốt"
    micro_cycles ||--o{ contingency_plans : "sinh ra"
    EscalationTickets }o--|| MarketSnapshots : "kèm snapshot"
