%% D08-decision-sequence.mmd
%% Sequence diagram: Vòng đời quyết định (H1 close / C3 wake -> Snapshot -> A/B -> HardValidator -> SQLite Queue -> Executor -> MT5)
sequenceDiagram
    autonumber
    participant S as Scheduler / Timer
    participant E as Eye Engine (Python)
    participant Exp as ExperienceDB
    participant A as Agent A (Planner)
    participant B as Agent B (Challenger)
    participant V as HardValidator (Rails)
    participant DB as SQLite (MarketOrderInfo)
    participant EX as Executor Thread
    participant MT5 as MetaTrader 5

    S->>E: Trigger Wake (H1 Close Event hoặc C3 Intra-bar Timer)
    E->>MT5: Lấy vị thế thực tế (Positions, Balance, Equity)
    MT5-->>E: Trả về trạng thái tài khoản & vị thế mở
    E->>E: Tính Swing D1, BOS, ATR, H1 Strength Score & DQ, SpacingMet
    E->>A: Cung cấp MarketSnapshot (Data only, không ra lệnh)
    
    A->>Exp: get_memory_pack(symbol, context, action)
    Exp-->>A: MemoryPack (Evergreen + Dynamic top 6)
    A->>B: Chia sẻ Snapshot + MemoryPack

    Note over A: Phân tích bối cảnh D1 & Tín hiệu H1 / Spacing
    A->>A: Soạn thảo TradePlan (ENTRY / DCA / PAYOFF / CLOSE / WAIT)
    A->>B: Gửi TradePlan yêu cầu thẩm định
    
    Note over B: Đánh giá độc lập & Tìm phản chứng
    B->>B: Kiểm tra vi phạm AVOID / Rủi ro S-R / Anti-sycophancy
    B-->>A: Trả về ReviewBallot (APPROVE / CHALLENGE / VETO)
    
    alt B CHALLENGE (round < 2)
        A->>A: Điều chỉnh kế hoạch (Revise Plan)
        A->>B: Gửi lại TradePlan_v2
        B-->>A: ReviewBallot_v2
    end

    alt B APPROVE
        A->>V: Kiểm tra HardValidator (5 checks an toàn)
        alt HardValidator PASS
            A->>DB: INSERT INTO MarketOrderInfo (status='PENDING')
            V->>DB: Ghi AuditLog & Session Logs
            
            loop Executor Polling
                EX->>DB: UPDATE MarketOrderInfo SET status='PROCESSING' (Atomic Claim)
                DB-->>EX: Khóa thành công 1 bản ghi
                EX->>MT5: Thực thi OrderSend() / OrderClose()
                MT5-->>EX: Trả về kết quả khớp lệnh (Ticket, ExecutedPrice)
                EX->>DB: BEGIN TRANSACTION
                EX->>DB: INSERT INTO MarketOrderInfoArchive
                EX->>DB: DELETE FROM MarketOrderInfo WHERE id = ?
                EX->>DB: UPDATE PairState (total_lot, state, ladder_step)
                EX->>DB: COMMIT TRANSACTION
            end
        else HardValidator FAIL
            V->>DB: Ghi AuditLog (REJECTED_BY_RAILS)
        end
    else B VETO / DEFER
        A->>DB: Ghi AuditLog (DEFER_BY_CHALLENGER)
    end
    
    A->>S: Thiết lập lịch Wake-up tiếp theo (Next H1 Close khi FLAT; C3 dynamic khi OPEN)
