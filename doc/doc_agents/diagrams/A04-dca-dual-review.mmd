%% A04 — DCA dual-review loop from order 2+
%% Spec: 07-dca-dual-review-loop, 08-map-to-phuong-phap

flowchart TD
  Start([Wake_OPEN_C3_or_Boss]) --> Refresh["A_refresh_TotalLot_BasketDir_PnL_State"]
  Refresh --> Zero{"TotalLot_eq_0?"}
  Zero -->|Yes| Flat["PairState_FLAT\nWakeRequest_C1_or_C2"]
  Zero -->|No| Assess["A_chart_review\nspacing_squeeze_recovery_rules"]

  Assess --> Prop{"proposed_action"}
