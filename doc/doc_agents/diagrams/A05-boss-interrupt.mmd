%% A05 — Boss interrupt v1: no Override; B.APPROVE required to enqueue
sequenceDiagram
  autonumber
  participant Boss as Boss_Human
  participant Orch as Orchestrator
  participant A as AgentA
  participant B as AgentB
  participant Exp as ExperienceDB
  participant HV as HardValidator
  participant Q as MarketOrderInfo
  participant EX as Executor
  participant MT5 as MT5_Broker

  Note over A,B: May_be_SLEEPING
  Boss->>Orch: BossWake_intent
  Orch->>Orch: cancel_sleep_session_BOSS
  Orch->>A: ForceWake
  Orch->>B: ForceWake
  A->>Exp: get_memory_pack
  A->>A: Observe_plus_Boss_intent
  A->>HV: TradePlan
  HV-->>A: HardPass_or_Fail
  alt HardFail
    A->>Boss: Explain_blocked_by_rails
  else HardPass
    A->>B: Plan
    B->>Boss: Independent_ballot
    loop BossChat_max_turns
      Boss->>A: Question
      A->>Boss: Clarification
      B->>Boss: Counter_evidence
    end
    Boss->>Orch: BossACK_optional_log
    alt B_APPROVE
      A->>Q: INSERT_PENDING
      EX->>MT5: OrderSend
      MT5-->>EX: Fill
    else B_dissent
      A->>Orch: DEFER_WakeRequest_C1_C2_C3
      Note over Boss: No_Override_v1
    end
  end
  Orch->>Orch: session_mode_AUTO
  A->>Orch: WakeRequest_next
