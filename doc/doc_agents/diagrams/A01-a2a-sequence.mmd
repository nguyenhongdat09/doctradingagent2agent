%% A01 — A2A sequence: wake → memory → plan → ballot → enqueue → Executor → MT5
%% Spec: 06-entry-flow, 03-consensus, 07-dca-dual-review-loop, doc_experience

sequenceDiagram
  autonumber
  participant Orch as Orchestrator
  participant Eye as Engine_Eyes
  participant A as AgentA_Planner
  participant Exp as ExperienceDB
  participant HV as HardValidator
  participant B as AgentB_Challenger
  participant Q as MarketOrderInfo_Queue
  participant EX as Executor_Thread
  participant MT5 as MT5_Broker

  Orch->>A: Wake (H1_Close hoặc C3_Dynamic)
  Orch->>B: Wake_B
  Eye->>A: MarketSnapshot (swings, strength, spacing_met, basket)
  Eye->>B: MarketSnapshot (same data)
  A->>Exp: get_memory_pack(symbol,context,action)
  Exp-->>A: MemoryPack
  A->>A: Phân tích D1/H1/Spacing & Draft TradePlan (ENTRY/DCA/PAYOFF/CLOSE/WAIT)
  
  alt action == WAIT
    A->>Orch: WakeRequest (C0/C1/C2 khi FLAT; C3 khi OPEN)
  else action in [ENTRY, DCA, RECOVERY_DCA, PAYOFF_REDUCE, CLOSE_ALL]
    A->>HV: Pre-validate HardValidator
    alt HardFail
      A->>Orch: WakeRequest_DEFER
    else HardPass
      A->>B: Gửi TradePlan
      B->>Exp: get_memory_pack (độc lập)
      B->>B: Thẩm định độc lập + tìm counter-evidence
      B->>A: ReviewBallot (APPROVE | CHALLENGE | VETO)
      
      alt B_CHALLENGE (round < 2)
        A->>A: Revise TradePlan
        A->>HV: Validate revised
        A->>B: TradePlan_v2
        B->>A: ReviewBallot_v2
      end
      
      alt B_APPROVE
        A->>Q: INSERT INTO MarketOrderInfo (status='PENDING')
        EX->>Q: Atomic Claim (status='PROCESSING')
        EX->>MT5: OrderSend / OrderClose
        MT5-->>EX: Kết quả khớp lệnh (Ticket / Price / Error)
        alt Success
          EX->>Q: Archive record + Delete PENDING
          EX->>Orch: ExecutionReport (FILLED)
          A->>Orch: WakeRequest (C3 khi OPEN; C0/C1 khi FLAT)
        else Fail
          EX->>Q: Mark FAILED + Alert Boss
        end
      else B_VETO / Dissent
        A->>Orch: WakeRequest_DEFER (không enqueue)
      end
    end
  end
  Orch->>Orch: Sleep until next_wake_at (hoặc BossWake)
